{
  "name": "@aldel/reverbgen",
  "version": "2.0.2",
  "description": "A TypeScript library for generating artificial reverb impulse responses.",
  "type": "module",
  "main": "./dist/reverbgen.cjs",
  "module": "./dist/reverbgen.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/reverbgen.js",
      "require": "./dist/reverbgen.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build:lib": "vite build --config vite.lib.config.ts",
    "build:demo": "vite build",
    "build": "npm run build:lib && npm run build:demo",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adelespinasse/reverbGen.git"
  },
  "keywords": [
    "impulse-response",
    "reverb",
    "audio",
    "sound",
    "reverberation",
    "echo"
  ],
  "author": "Alan deLespinasse",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/adelespinasse/reverbGen/issues"
  },
  "homepage": "https://github.com/adelespinasse/reverbGen",
  "devDependencies": {
    "@types/node": "^25.3.5",
    "typescript": "^5.0.0",
    "unplugin-dts": "^1.0.0",
    "vite": "^8.0.13"
  }
}
